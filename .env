# Fill in the values between the quotes, then run: python main.py
# Leave optional values empty ('') to turn that feature off.

# --- ManusPlus account (required) ---
# company_name is the part before ".manus.plus" in your ManusPlus address
company_name=''
manus_username=''
manus_password=''

# --- Event basics (required) ---
# event_timezone must be a TZ name, e.g. 'Europe/Amsterdam'
event_summary=''
event_timezone=''

# --- Event location (optional) ---
# Include city and country so it resolves to a map pin
event_location=''
event_location_title=''

# --- Travel allowance (optional) ---
# Per kilometre, and the one-way distance. The journey is counted twice.
travel_allowance_per_km=''
single_ride_journey_km=''

# --- Apple / iCloud Calendar (optional) ---
# icloud_app_password must be an app-specific password from appleid.apple.com
icloud_username=''
icloud_app_password=''
icloud_calendar_name=''
